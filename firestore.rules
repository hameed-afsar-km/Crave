rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ─────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return !isAuth() ? 'customer' : (
        request.auth.token.role != null ? request.auth.token.role : (
          getUserData().exists ? getUserData().data.role : 'customer'
        )
      );
    }

    function getUserAssignedOutlet() {
      let userData = getUserData();
      return userData != null && userData.exists ? userData.data.assignedOutletId : null;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isManager() {
      return isAuth() && getUserRole() == 'outlet_manager';
    }

    function isStaff() {
      return isAuth() && getUserRole() == 'outlet_staff';
    }

    function isStaffOrAbove() {
      return isAdmin() || isManager() || isStaff();
    }

    function canAccessOutlet(outletId) {
      return isAdmin() || getUserAssignedOutlet() == outletId;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ─── OUTLETS ─────────────────────────────────────
    // Public read (menu/storefront), admin create/delete,
    // manager can update their own outlet

    match /outlets/{outletId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isManager() && getUserAssignedOutlet() == outletId);
      allow delete: if isAdmin();
    }

    // ─── MENU ITEMS ──────────────────────────────────
    // Public read, staff+ can create/update, admin delete

    match /menu-items/{itemId} {
      allow read: if true;
      allow create: if isStaffOrAbove();
      allow update: if isStaffOrAbove();
      allow delete: if isAdmin();
    }

    // ─── ORDERS ──────────────────────────────────────
    // Customers: read own orders; update only to cancel
    // Staff/Manager: orders for assigned outlet
    // Admin: everything

    match /orders/{orderId} {
      allow get: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        (isStaffOrAbove() && (isAdmin() || canAccessOutlet(resource.data.outletId)))
      );
      allow list: if isAuth() && isStaffOrAbove();
      allow create: if isAuth();
      allow update: if isAuth() && (
        (isStaffOrAbove() && (isAdmin() || canAccessOutlet(resource.data.outletId))
          // Staff can only change operational fields — never server-owned fields
          && (isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'customerId', 'customerName', 'customerPhone', 'customerEmail',
            'amount', 'currency',
            'items',
            'paymentId', 'razorpayOrderId', 'paymentStatus',
            'outletId',
            'createdAt', 'pointsEarned'
          ]) == false))
        ||
        // Customers may only cancel their own non-finalized order
        (
          resource.data.customerId == request.auth.uid
          && resource.data.status in ['received', 'preparing']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.items == resource.data.items
          && request.resource.data.pickupTime == resource.data.pickupTime
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.outletId == resource.data.outletId
          && request.resource.data.paymentId == resource.data.paymentId
          && request.resource.data.createdAt == resource.data.createdAt
        )
      );
      allow delete: if isAdmin();
    }

    // ─── SETTINGS ──────────────────────────────────
    // Global store settings — admin-only write

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── USERS ───────────────────────────────────────
    // Self-service read for own profile, staff can read others
    // Self-update limited to profile fields only
    // Admin can write any field on any user

    match /users/{userId} {
      // NOTE: We use custom claims (request.auth.token.role) here instead of
      // isAdmin()/isStaffOrAbove() to avoid infinite recursion — those helpers
      // call getUserData() → get(/users/{uid}) which re-enters this rule.
      allow read: if isAuth() && (isOwner(userId) || request.auth.token.role in ['admin', 'outlet_manager', 'outlet_staff']);
      allow create: if isAuth() && isOwner(userId);
      allow update: if isAuth() && (
        isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email', 'photoURL', 'address', 'updatedAt']) &&
          (request.resource.data.role == 'customer' || request.resource.data.role == resource.data.role) &&
          (resource.data.role != 'admin' || request.resource.data.role == resource.data.role)
        )
      );
      allow delete: if isAdmin();
    }

    // ─── AUDIT LOGS ──────────────────────────────────
    // Immutable record — admin read, authenticated create, admin manage

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaffOrAbove();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── BUG REPORTS ─────────────────────────────────
    // Authenticated create, admin read/manage, author can read own

    match /bugReports/{reportId} {
      allow get: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── PUSH SUBSCRIPTIONS ──────────────────────────
    // Tied to user — self-manage, admin read

    match /pushSubscriptions/{subId} {
      allow get: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── DENY ALL ELSE ──────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
