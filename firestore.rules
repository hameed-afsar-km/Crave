rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Master admin check via email
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kmafsar2006@gmail.com';
    }

    // Authenticated user check
    function isAuth() {
      return request.auth != null;
    }

    // ─── OUTLETS ───────────────────────────────────
    match /outlets/{outletId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── MENU ITEMS ──────────────────────────────────
    match /menu-items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── ORDERS ──────────────────────────────────────
    // Authenticated users can read/create their own.
    // Admin can read/write all.
    // App-level filtering handles outlet isolation.
    match /orders/{orderId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin() || (isAuth() && resource.data.customerId == request.auth.uid);
    }

    // ─── SETTINGS ────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── USERS ───────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
  }
}
