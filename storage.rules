rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Menu item images — authenticated staff+ can upload
    match /menu-items/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|image/avif')
        && fileName.matches('.*\\.(jpg|jpeg|png|webp|avif)$');
      allow delete: if request.auth != null;
    }

    // Deny all other uploads
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
